---
import '../styles/global.css';
import { SITE, LANG_META, type Lang } from '../data/site';
import { ACTIVE_LANGS } from '../i18n';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Partial<Record<Lang, string>>;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
}
const { lang, title, description, path, alternates, ogType = 'website', jsonLd = [] } = Astro.props;
const meta = LANG_META[lang];
const canonical = SITE + path;
const fonts = [
  'family=Noto+Serif:ital,wght@0,400;0,700;0,800;1,400',
  'family=Roboto:ital,wght@0,400;0,500;0,700;1,400',
  ...(lang === 'ar' ? ['family=Noto+Naskh+Arabic:wght@400;700', 'family=Noto+Sans+Arabic:wght@400;500;700'] : []),
].join('&');
---
<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {ACTIVE_LANGS.map((l) => <link rel="alternate" hreflang={l} href={SITE + alternates[l]} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + (alternates.en ?? path)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="German Exam Simulator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {ACTIVE_LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#E7E0D2" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <Nav lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
  </body>
</html>
