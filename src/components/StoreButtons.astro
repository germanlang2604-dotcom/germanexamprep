---
import { STORE, type Lang } from '../data/site';
import { dict } from '../i18n';

interface Props { lang: Lang; long?: boolean; id?: string }
const { lang, long = false, id } = Astro.props;
const d = dict(lang);
---
<div class="hero-cta" id={id}>
  <a class="btn btn-ink" href={STORE.play} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/></svg>
    {long ? d.store.playLong : d.store.play}
  </a>
  <a class="btn btn-line" href={STORE.apple} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71,19.5C17.88,20.5 17,21.43 15.66,21.5C14.33,21.57 13.86,20.75 12.33,20.75C10.81,20.75 10.28,21.43 9.04,21.57C7.69,21.71 6.68,20.64 5.84,19.64C4.14,17.6 2.84,13.88 4.59,11.35C5.45,10.1 6.85,9.3 8.36,9.27C9.63,9.24 10.82,10.15 11.58,10.15C12.34,10.15 13.79,9.07 15.35,9.23C16.03,9.26 17.63,9.51 18.65,10.97C18.56,11.03 16.57,12.19 16.59,14.62C16.62,17.52 19.07,18.47 19.12,18.49C19.07,18.61 18.76,19.53 18.71,19.5M13,3.5C13.73,2.67 14.94,2.04 15.94,2C16.07,3.17 15.6,4.35 14.9,5.19C14.21,6.04 13.07,6.7 11.95,6.61C11.8,5.46 12.36,4.26 13,3.5Z"/></svg>
    {long ? d.store.appleLong : d.store.apple}
  </a>
</div>
